# Copy these into Vercel -> Project -> Settings -> Environment Variables (do NOT commit real values)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=ab@sopnotec.com
SMTP_PASS=your-mailbox-password
LEAD_TO=abubakar@sopnotec.com, ab@sopnotec.com, support@sopnotec.com

# Spam protection — Cloudflare Turnstile (free): https://dash.cloudflare.com -> Turnstile -> Add widget (domain: sopnotec.com)
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET=your-turnstile-secret-key
# Optional: long random string used to sign form tokens (defaults to SMTP_PASS)
FORM_SECRET=
